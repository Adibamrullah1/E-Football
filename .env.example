# ─── Storage ─────────────────────────────────────────────────────────────────
# Vercel Blob (production only — auto-injected when you connect a Blob store)
# Create a Blob store in your Vercel project > Storage tab, then:
#   vercel env pull   ← downloads this automatically
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─── NextAuth ─────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-a-random-secret-here"
AUTH_TRUST_HOST="true"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="eFootball League"
